# Command used to start Codex app-server.
CODEX_IMAGE_COMMAND=codex

# Optional Codex conversation/thread model. Defaults to gpt-5.5 in code.
# This is not an image generation model.
CODEX_THREAD_MODEL=gpt-5.5

# Timeouts in milliseconds.
CODEX_IMAGE_APP_SERVER_TIMEOUT_MS=15000
CODEX_IMAGE_TIMEOUT_MS=120000

# HTTP server.
CODEX_IMAGE_HOST=127.0.0.1
CODEX_IMAGE_PORT=4020

# Default output folder for generated PNG files.
CODEX_IMAGE_OUTPUT_DIR=outputs
