# Optional command used to start Codex app-server.
# Leave empty to prefer the macOS Codex Desktop bundled binary automatically.
CODEX_APP_SERVER_COMMAND=

# Optional Codex conversation/thread model. Defaults to gpt-5.5 in code.
# This is not an image generation model.
CODEX_THREAD_MODEL=gpt-5.5

# Codex thread sandbox. Native Codex Desktop image generation currently matches
# a normal app thread with danger-full-access.
CODEX_IMAGE_SANDBOX=danger-full-access

# Timeouts in milliseconds.
CODEX_IMAGE_APP_SERVER_TIMEOUT_MS=30000
CODEX_IMAGE_TIMEOUT_MS=120000

# HTTP server.
CODEX_IMAGE_HOST=127.0.0.1
CODEX_IMAGE_PORT=4020

# Default output folder for generated PNG files.
CODEX_IMAGE_OUTPUT_DIR=outputs
